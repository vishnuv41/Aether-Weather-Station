
# Backend server
PORT=5000
CORS_ORIGIN=*

# AWS region
AWS_REGION=us-east-1

# DynamoDB
TABLE_NAME=WeatherData
DEVICE_ID=ESP32_Weather

# AWS IAM credentials for DynamoDB
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# AWS IoT Core endpoint
AWS_IOT_ENDPOINT=your_aws_iot_endpoint

# AWS IoT MQTT topics
AWS_IOT_DATA_TOPIC=weatherStation/data
AWS_IOT_CONTROL_TOPIC=weatherStation/control

# AWS IoT certificate paths (relative to backend/)
AWS_IOT_CA_PATH=./certs/AmazonRootCA1.pem
AWS_IOT_CERT_PATH=./certs/device-cert.pem.crt
AWS_IOT_KEY_PATH=./certs/private.pem.key

# Device offline threshold in milliseconds
DEVICE_OFFLINE_THRESHOLD_MS=90000
